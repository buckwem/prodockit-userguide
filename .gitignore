# Environments
.venv

# Node (mermaid-cli, used by `prodockit pdf` to pre-render mermaid diagrams
# for the PDF - WeasyPrint has no JS engine to run Mermaid.js the way the
# live site does). Installed with `npm ci --prefix tools/mermaid`.
tools/mermaid/node_modules

# Node (mathjax-full, used by `prodockit pdf` to pre-render TeX maths for
# the PDF, same reason). Installed with `npm ci --prefix tools/mathjax`.
tools/mathjax/node_modules

# MathJax bundle for the *website* - third-party code and generated
# configuration, neither of which belongs in this repository. Copied from
# tools/mathjax's pinned install so the site and the PDF typeset through
# the same MathJax (prodockit-extensions#263). `prodockit bootstrap` writes
# these on a developer's machine; CI installs them the same way (see
# .github/workflows/docs.yml, .gitlab-ci.yml).
docs/javascripts/vendor/
docs/javascripts/mathjax.js

# Artifacts
__pycache__
.pytest_cache

# macOS internals
.DS_Store

# Temporary files
tmp
.cache/
public/

# Generated PDF build output
docs/site_documentation.pdf
docs/source_bundle.pdf
docs/.prodockit-pdf-mermaid/

# Local Claude Code config (dev-preview launch config, personal permissions)
.claude/

# Pandoc/WeasyPrint temp artefacts occasionally left in the project root by
# an interrupted `prodockit pdf` run - never wanted in the repository.
toPdfViaTempFile*.pdf
