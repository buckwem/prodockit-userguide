tmp
.cache/
public/
.zensical-canonical.toml

# Generated PDF build output
docs/site_documentation.pdf
docs/source_bundle.pdf
docs/.prodockit-pdf-mermaid/

# Citation style for prodockit.bibliography - fetched, not vendored (see
# "An alternative: prodockit.bibliography" in customisecontent.md and
# prodockit-userguide#97). Matches prodockit-template's own .gitignore.
/harvard-cite-them-right.csl

# Local Claude Code config (dev-preview launch config, personal permissions)
.claude/

# Pandoc/WeasyPrint temp artefacts occasionally left in the project root by
# an interrupted `prodockit pdf` run - never wanted in the repository.
toPdfViaTempFile*.pdf

# Installed by `prodockit adopt`
/.prodockit-adopt-backups/

# Local environments and generated output — added by prodockit adopt
.venv/
__pycache__/
*.py[cod]
/site/
/public/
/docs/site_documentation.pdf
/docs/source_bundle.pdf
/docs/.prodockit-pdf-mermaid/
